def display_verse(row):
    """Displays the verse and reference as plain text from a DataFrame row."""
    surah_num = int(row['surah'])
    ayah_num = int(row['ayah'])
    verse_text = row['text']

    surah_name = SURAH_NAMES[surah_num - 1]

    # Format reference
    reference = f"{surah_name} ({surah_num}:{ayah_num})"

    # Combine verse and reference into a single string
    print(f'{verse_text} - {reference}')


if __name__ == "__main__":
    # Read the CSV file
    try:
        df = pd.read_csv(CSV_PATH)
    except FileNotFoundError:
        print(f"Error: Could not find '{CSV_PATH}'")
        exit(1)

    # Determine which row to display
    if len(argv) == 3:
        try:
            surah_num, ayah_num = int(argv[1]), int(argv[2])
            # Filter for the specific verse
            selected_row = df[(df['surah'] == surah_num) & (df['ayah'] == ayah_num)]

            if selected_row.empty:
                print(f"Verse {surah_num}:{ayah_num} not found in CSV.")
                exit(1)

            row = selected_row.iloc[0]
        except ValueError:
            print("Invalid arguments. Please provide numbers for Surah and Verse.")
            exit(1)
    else:
        # If no arguments, pick one random row directly from the DataFrame
        row = df.sample(1).iloc[0]

    # Display the selected row
    display_verse(row)
